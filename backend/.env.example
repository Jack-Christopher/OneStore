z# ============================================
# OneStore Backend Environment Variables
# ============================================
# Copy this file to .env and update with your values
# cp .env.example .env

# ============================================
# Server Configuration
# ============================================

# Backend server port
# Default: 4000
PORT=4000

# ============================================
# Database Configuration
# ============================================

# MongoDB connection string
# Format: mongodb://[username:password@]host[:port]/[database][?options]
# 
# Examples:
# - Local development: mongodb://localhost:27017/onestore
# - Docker Compose: mongodb://db:27017/onestore
# - External MongoDB: mongodb://user:pass@host:27017/onestore?authSource=admin
# - MongoDB Atlas: mongodb+srv://user:pass@cluster.mongodb.net/onestore?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/onestore
MONGO_DB=onestore

# ============================================
# Security Configuration
# ============================================

# JWT Secret Key for token signing and verification
# ⚠️ REQUIRED: Generate a strong random secret for production
# 
# Generate a secure secret:
#   openssl rand -base64 32
#   OR
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 
# ⚠️ NEVER commit this value to version control
# ⚠️ Use different secrets for development, staging, and production
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ============================================
# Environment
# ============================================

# Node environment
# Options: production, development, test
NODE_ENV=development
