# ============================================
# OneStore Frontend Environment Variables
# ============================================
# Copy this file to .env and update with your values
# cp .env.example .env
#
# Note: Vite requires the VITE_ prefix for environment variables
# These variables are embedded at build time, not runtime
# ============================================

# ============================================
# API Configuration
# ============================================

# Backend API base URL
# This is the URL the frontend will use to make API requests
#
# Examples:
# - Local development: http://localhost:4000
# - Same domain (production): /api
# - Different domain: https://api.yourdomain.com/api
# - With subdomain: https://api.yourdomain.com
#
# ⚠️ For production builds, this value is embedded at build time
# ⚠️ If using Docker, this is passed as a build argument
# ⚠️ For same-domain deployment, use /api (relative path)
VITE_API_URL=http://localhost:4000

# ============================================
# Development Configuration
# ============================================

# Vite development server port
# This is configured in vite.config.ts, but can be overridden here
# Default: 5173
# VITE_PORT=5173

# ============================================
# Build Configuration
# ============================================

# Build mode
# Options: development, production
# This is automatically set by Vite based on the build command
# MODE=development


# ============================================
# Other Configuration
# ============================================

# App general name
VITE_APP_NAME=OneStore
# App general language
VITE_DEFAULT_LANG=en
