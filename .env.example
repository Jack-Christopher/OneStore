# ============================================
# OneStore Environment Variables
# ============================================
# Copy this file to .env and fill in the actual values
# NEVER commit .env to version control!

# ============================================
# MongoDB Configuration
# ============================================
# MongoDB root user credentials (REQUIRED for production)
# These are used to create the initial admin user in MongoDB
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD
MONGO_INITDB_DATABASE=onestore

# ============================================
# Application Security
# ============================================
# JWT Secret for token signing (REQUIRED)
# Generate a strong random string (e.g., openssl rand -base64 32)
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET

# ============================================
# Server Ports
# ============================================
# Backend API port (default: 4000)
PORT=4000
BACKEND_PORT=4000

# Frontend port (default: 80)
FRONTEND_PORT=80

# ============================================
# Frontend Configuration
# ============================================
# API URL for the frontend (usually http://localhost:4000 for dev)
# For production, use your domain: https://api.yourdomain.com
VITE_API_URL=http://localhost:4000

# ============================================
# MongoDB Connection (Optional)
# ============================================
# If not set, it will be automatically constructed from MONGO_INITDB_* variables
# Format: mongodb://username:password@db:27017/database?authSource=admin
# MONGO_URI=mongodb://admin:password@db:27017/onestore?authSource=admin
