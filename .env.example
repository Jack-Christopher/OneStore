# ============================================
# OneStore Production Environment Variables
# ============================================
# Copy this file to .env and update with your production values
# cp .env.example .env

# ============================================
# Docker Compose Configuration
# ============================================

# Frontend Configuration
# The API URL that the frontend will use to communicate with the backend
# In production, this should be your backend API URL (e.g., https://api.yourdomain.com/api)
# For same-domain deployment, use: /api
VITE_API_URL=/

# Frontend container port mapping (host:container)
# Default: 80 (standard HTTP port)
FRONTEND_PORT=80

# Backend container port mapping (host:container)
# Default: 4000
BACKEND_PORT=4000

# MongoDB container port mapping (host:container)
# Default: 27017
MONGO_PORT=27017

# ============================================
# Backend API Configuration
# ============================================

# Backend server port (must match BACKEND_PORT above)
# Default: 4000
PORT=4000

# MongoDB connection string
# Format: mongodb://[username:password@]host[:port]/[database][?options]
# For Docker Compose: mongodb://db:27017/onestore
# For external MongoDB: mongodb://user:pass@host:27017/onestore?authSource=admin
# For MongoDB Atlas: mongodb+srv://user:pass@cluster.mongodb.net/onestore?retryWrites=true&w=majority
MONGO_URI=mongodb://db:27017/onestore

# JWT Secret Key for token signing and verification
# ⚠️ REQUIRED: Generate a strong random secret for production
# Use: openssl rand -base64 32
# Or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Node environment
# Options: production, development, test
ENV=production

PROJECT_NAME=OneStore
